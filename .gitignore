# ── Go ──────────────────────────────────────────────
# Собранные бинари
/team-docs
/team-docs.exe
*.exe
# Артефакты тестов/покрытия
*.test
*.out
coverage.*
# Go workspace
go.work
go.work.sum
# Вендоринг: зависимости тянутся из go.mod/go.sum (go mod download).
# Локально каталог используется для -mod=vendor, но в репозиторий не кладём.
/vendor/

# ── Фронтенд (Vite) ─────────────────────────────────
/web/node_modules/
# lock не коммитим: разные мажоры npm генерируют несовместимые lock-файлы
/web/package-lock.json
/web/dist/
/web/dist-ssr/
/web/*.local
# Логи npm/pnpm/yarn
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Данные приложения ───────────────────────────────
# Загрузки хранятся в БД; каталог оставлен как задел
/data/

# ── Конфиги и секреты ───────────────────────────────
appsettings.local.yaml
*.local.yaml
.env
.env.*
!.env.example

# ── IDE / редакторы ─────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── ОС ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
